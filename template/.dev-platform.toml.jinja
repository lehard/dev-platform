schema_version = 2
platform_version = "1.0.0"
platform_ci_ref = "{{ platform_ci_ref }}"
project_name = "{{ project_name }}"
project_slug = "{{ project_slug }}"
main_branch = "{{ main_branch }}"
workflow_profile = "{{ workflow_profile }}"
harness_mode = "{{ harness_mode }}"
protected_main = {{ 'true' if protected_main else 'false' }}
publish_mode = "{{ publish_mode }}"
pr_merge_mode = "{{ pr_merge_mode }}"
agent_tools = "{{ agent_tools }}"
project_required_files = []

[capabilities]
openspec = true
github_sync = true
feature_branches = {{ 'true' if workflow_profile in ['standard', 'multi-agent'] else 'false' }}
worktrees = {{ 'true' if workflow_profile == 'multi-agent' else 'false' }}
agent_board = {{ 'true' if workflow_profile == 'multi-agent' else 'false' }}
platform_git_lifecycle = {{ 'true' if harness_mode == 'platform' else 'false' }}

[tools.openspec]
min_version = "1.6.0"
tested_version = "1.6.0"
verify_required = true

[tools.copier]
min_version = "9.17.0"
tested_version = "9.17.0"

[tools.rollout]
bot_login = "dev-platform-bot-lehard[bot]"

[model_routing]
enabled = true

[model_routing.codex]
routine_model = "gpt-5.6-terra"
standard_model = "gpt-5.6-terra"
complex_model = "gpt-5.6-sol"

[model_routing.claude]
routine_model = "haiku"
standard_model = "sonnet"
complex_model = "opus"

[promotion]
repo = "lehard/dev-platform"

[development_backlog]
repository = "{{ development_backlog_repository }}"
project_label = "{{ development_backlog_project_label }}"
default_priority = "{{ development_backlog_default_priority }}"
project_owner = "{{ development_backlog_project_owner }}"
project_number = {{ development_backlog_project_number }}

[process_health]
process_label = "process"
managed_label = "process:managed"

[paths]
worktrees = ".claude/worktrees"
agent_board = ".claude/agents-board.json"
main_merge_lock = ".claude/main-merge.lock"
pending_worktrees = ".claude/pending-worktrees.md"
friction_log = ".claude/agent-friction.jsonl"
friction_state = ".claude/agent-friction-state.json"
friction_reports = ".claude/reports/process-improvement"
checks = "dev-platform/checks.toml"
