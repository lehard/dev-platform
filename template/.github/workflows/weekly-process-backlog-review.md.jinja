---
name: Weekly Process Backlog Review
description: Freshness-aware, read-only weekly process-health review.

on:
  schedule: weekly
  workflow_dispatch:

permissions:
  contents: read
  issues: read
  pull-requests: read

engine: codex
network: defaults
timeout-minutes: 10
max-ai-credits: 100
max-daily-ai-credits: 100
max-turns: 10

tools:
  github:
    toolsets: [issues, labels, pull_requests, repos]
    min-integrity: none
    allowed-repos: public

safe-outputs:
  allowed-domains: []
  mentions: false
  threat-detection:
    max-ai-credits: 25
  create-issue:
    title-prefix: "[process-backlog] "
    labels: [process]
    close-older-issues: true
    max: 1
