{% set runner_labels = ci_runner_labels.split(',') | map('trim') | list if ci_runner == 'self-hosted' else [] -%}
name: Provision Process Health Labels

on:
  workflow_dispatch:

permissions:
  issues: write

jobs:
  provision:
    runs-on: {{ 'ubuntu-latest' if ci_runner == 'github-hosted' else (runner_labels[0] | tojson if runner_labels | length == 1 else runner_labels | tojson) }}
    timeout-minutes: 5
    steps:
      - name: Ensure bounded lifecycle label exists
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
          REPOSITORY: {% raw %}${{ github.repository }}{% endraw %}
        run: |
          AUTH="Authorization: Bearer ${GH_TOKEN}"
          if ! curl -fsS -H "$AUTH" "https://api.github.com/repos/${REPOSITORY}/labels/process%3Amanaged" >/dev/null 2>&1; then
            curl -fsS -X POST -H "$AUTH" -H 'Content-Type: application/json' \
              "https://api.github.com/repos/${REPOSITORY}/labels" \
              -d '{"name":"process:managed","color":"1d76db","description":"Process evidence linked to an active managed task"}'
          fi
