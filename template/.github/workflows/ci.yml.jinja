name: CI

on:
  pull_request:
  push:
    branches:
      - {{ main_branch }}
  workflow_dispatch:

jobs:
  platform-ci:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6
        with:
          fetch-depth: 0

      - uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1 # v6
        with:
          python-version: "3.11"

      - name: Run selected platform-managed checks
        if: github.event_name == 'pull_request'
        run: python3 scripts/select_checks.py --base "origin/${{ github.base_ref }}" --execute

      - name: Run full platform-managed checks
        if: github.event_name != 'pull_request'
        run: python3 scripts/select_checks.py --full --execute
