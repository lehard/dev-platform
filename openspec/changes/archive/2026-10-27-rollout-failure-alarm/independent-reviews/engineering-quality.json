  "findings": [
    {
      "evidence": "scripts/rollout_alarm.py `open_alarm` does a list-then-create with no lock. When it finds more than one match it raises `AlarmError(\"more than one open alarm for ...\")`. Manual dispatches for different scopes can run at the same time, and the workflow has no concurrency group on the `alarm` job. The alarm job then fails permanently for that tag until someone closes one of the duplicates by hand. Also, `--limit 100` on `issue list` is not paginated.",
      "id": "alarm-duplicate-open-issue-wedge",
      "severity": "advisory",
      "summary": "Concurrent or racing alarm jobs for the same release tag can create two open `Managed rollout failed: <tag>` issues. After that, every later alarm run for that tag fails."
    }
  ],
