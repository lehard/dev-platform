          "evidence": {
            "engineering-quality": {
              "availability": "available",
              "findings": [
                {
                  "evidence": "template/scripts/lifecycle_workers.py: `identity = job[\"task_identity\"]` followed by `composition_repair = kind == \"repair\" and isinstance(identity, dict) and ...`",
                  "id": "execute-job-identity-keyerror",
                  "severity": "advisory",
                  "summary": "execute_job now reads job[\"task_identity\"] unconditionally for every job kind. A review or non-composition job record without that key raises KeyError before the existing \"no executor\" and provider checks. Use job.get(\"task_identity\") instead."
                },
                {
                  "evidence": "template/scripts/publication_queue.py run_worker: `progress = worker(root); resume_composition_ci(root, _repo(root)); return progress`; resume_composition_ci raises QueueError for inventory problems and `if failures: raise QueueError(...)`; the per-PR loop has no try/except around advance_final_publication.",
                  "id": "ci-resume-aborts-queue-run",
                  "severity": "advisory",
                  "summary": "run_worker calls resume_composition_ci after worker(root) has already done its work. An unrelated problem makes the whole queue run fail and discards the returned progress. The problems are an inventory at or above QUEUE_INVENTORY_LIMIT, a malformed row, any exception from one PR's advance_final_pub"
                }
